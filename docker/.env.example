# VIATOR — environment variables
#
# Copy to `.env` and fill in. This file holds bootstrap-only secrets that
# need to exist before Postgres + the platform_config table do. All other
# operational tunables (SMTP credentials, concurrency limits, retention
# windows, fanout timeouts) live in `platform_config` and are edited from
# Admin → Configuration in the UI.
#
# Generate strong values with: openssl rand -base64 32

# ────────────────────────────── Image version ──────────────────────────────
# Pin to a release tag for reproducible deploys, or `latest` to track main.
# Used by `docker compose pull|up` to select the image.
#
# Both forms are published — the `v`-prefixed git tag and the bare semver:
#   VIATOR_VERSION=v0.1.3   (matches the git tag, more obvious to read)
#   VIATOR_VERSION=0.1.3    (Docker convention)
#   VIATOR_VERSION=latest   (rolling main)
# Pre-v0.1.4 only the bare-semver form was published. If you're pinning to
# v0.1.0/v0.1.1/v0.1.2/v0.1.3, drop the `v`.
VIATOR_VERSION=latest

# ──────────────────────────────── Postgres ─────────────────────────────────
POSTGRES_USER=viator
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=viator

# ────────────────────────────── JWT auth ──────────────────────────────────
# 64+ random bytes. Rotating this invalidates every issued JWT (everyone
# logs out). Don't rotate without a planned operator notification.
JWT_SECRET=change-me-please-use-openssl-rand-base64-64
# Set to `true` once HTTPS is wired (step 9 of INSTALL.md). Leave false on
# plain HTTP or browsers won't accept the cookie.
JWT_COOKIE_SECURE=false

# ─────────────────────── First-platform-admin bootstrap ────────────────────
# Set ONCE on first deploy. Hit POST /api/auth/bootstrap-platform-user with
# this token to create the first platform_admin (see INSTALL.md §8).
# Then set BOOTSTRAP_TOKEN= (empty) and `docker compose restart web`.
BOOTSTRAP_TOKEN=change-me-please-one-time-only

# ──────────────────────────── Public base URL ──────────────────────────────
# Used to build absolute URLs in magic-link emails (registration confirm,
# password reset). Must match the public hostname users will click through.
PUBLIC_BASE_URL=http://localhost

# ───────────────────────── Station mapping module ──────────────────────────
# Address of the station module inside the Docker network: http://msmm-web:8000
# Token: the module's MSMM_INTERNAL_TOKEN, generated on the server, never committed.
# Both empty: the module is not used and the typeahead keeps VIATOR's own list.
# Read by web and worker (the worker waits for a station build before each
# MOTIS graph build); after a change recreate both: up -d --force-recreate web worker
STATION_MODULE_URL=
STATION_MODULE_TOKEN=

# ─────────────────────────────── Upload limits ─────────────────────────────
MAX_UPLOAD_MB=2048

# ──────────────────────────────── MOTIS version ───────────────────────────
# Leave both empty to use the version pinned in app/engine_versions.py.
# Every MOTIS version change makes the existing MOTIS graphs unreadable until
# rebuilt. VIATOR_MOTIS_VERSION sets build + serve. To try a candidate without
# touching what is live, set only VIATOR_MOTIS_BUILD_VERSION and rebuild: a
# failed build changes nothing, a successful one must be followed at once by
# setting VIATOR_MOTIS_VERSION to the same value (then `up -d web worker` and
# restart the session's motis-<sid> container).
VIATOR_MOTIS_VERSION=
VIATOR_MOTIS_BUILD_VERSION=

# ──────────────────────────────── OTP build resources ─────────────────────
# OTP graph build is RAM-bound. With OTP_BUILD_PHASES=two_phase (default),
# peak heap is much lower than legacy --build because the OSM parse and the
# transit overlay run in separate JVMs. Recommended sizes:
#   Île-de-France only:  OTP_BUILD_HEAP=8g    OTP_BUILD_MEM_LIMIT=12g
#   France-wide:         OTP_BUILD_HEAP=24g   OTP_BUILD_MEM_LIMIT=28g
OTP_BUILD_HEAP=8g

# Build pipeline: 'two_phase' (default) or 'one_shot' (legacy --build, debug
# only — needs ~30% more heap for the same input). Stay with two_phase unless
# you're chasing a regression that only reproduces in single-JVM mode.
OTP_BUILD_PHASES=two_phase

# Hard cgroup memory cap on the otp-build container. Should be `-Xmx` plus
# ~4 GB of native headroom (Direct buffers, metaspace, threads, GC). Setting
# this is what turns "the host slowly swaps for an hour" into a fast OOMKilled
# signal we can see in `docker compose logs`.
# Since issue #374 the cap comes with memswap_limit equal to it (no swap), and
# the worker derives the value from each build's heap, overriding this one:
# heap + max(4, heap/6, OTP_BUILD_MEM_HEADROOM_GB). A build that used to run
# just over its cap (into swap) now fails with exit 137: widen it here.
OTP_BUILD_MEM_LIMIT=12g
# Integer, in GB, no unit (a trailing "g" is tolerated; anything else is
# logged and the default used).
OTP_BUILD_MEM_HEADROOM_GB=4

# ──────────────────────── Serve memory caps (issue #374) ──────────────────
# Every cap below comes with a swap limit equal to it: a container at its cap
# is OOM-killed and visible (SessionContainerRestarted / ContainerOOMKilled
# alerts, exit 137 in a build log) instead of filling the
# host swap. A changed value reaches a session container only when compose
# recreates it (next reload, deploy, or `docker compose up -d <service>`);
# `docker restart` keeps the old limits.
#
# OTP serve containers: capped by default at serve heap + max(headroom,
# heap/3, 4g) — e.g. heap 12g -> 18g. The headroom can only widen the cap.
# `false` switches the caps off (the behaviour before #374).
OTP_SERVE_MEM_CAP=true
# Integer, in GB, no unit (same tolerance as OTP_BUILD_MEM_HEADROOM_GB).
OTP_SERVE_MEM_HEADROOM_GB=6
# MOTIS: no heap to derive a cap from, so empty = no cap (the default). To
# set one, read the container's peak on the "Container memory" panel and add
# a margin, e.g. MOTIS_SERVE_MEM_LIMIT=32g. Format: integer + g or m, at
# least 64m.
MOTIS_SERVE_MEM_LIMIT=
# Cap of the MOTIS build (`motis config` / `motis import`) containers.
MOTIS_BUILD_MEM_LIMIT=

# ─────────────── OTP serve: give unused heap back (issue #384) ─────────────
# How each OTP serve JVM returns heap it no longer uses to the host (admin
# guide §5.9). Serve containers only: graph builds keep their flags.
#   g1-uncommit (default): G1 with a periodic GC after 5 idle minutes (skipped
#     while the host's load is above its CPU count) and MinHeapFreeRatio=10 /
#     MaxHeapFreeRatio=50, so an idle router shrinks.
#   zgc: generational ZGC (-XX:+UseZGC), uncommits after 5 unused minutes.
#   legacy: the flags before #384, exactly (the way back).
# An unknown value is logged and g1-uncommit used; it never stops a router.
# Applies when compose next recreates the otp-<sid> containers (a deploy does).
OTP_SERVE_GC_MODE=g1-uncommit
# Optional, zgc only: -XX:SoftMaxHeapSize, a size like 24g. ZGC then aims to
# keep the heap below it but may still grow up to the session heap. Ignored,
# with a log line, when it is above a session's heap, or in another mode.
OTP_SERVE_SOFT_MAX_HEAP=
# Prometheus as web reaches it, for each OTP session's peak memory on the
# Sessions page. Leave commented for the in-network default
# (http://prometheus:9090/prometheus); set it empty to stop asking (the page
# then shows heap and cap only).
# PROMETHEUS_URL=

# ────────────────────────────── Rebuild debounce ───────────────────────────
# Worker coalesces upload-triggered rebuilds within this window (seconds).
# Default 30 min; lower for testing, higher for noisy operators.
DEBOUNCE_SECONDS=1800

# ───────────────── Phase-1 transitional — basic-auth upload UI ─────────────
# The upload UI on `/` (single-OTP Phase-1 surface) is still wired and uses
# HTTP basic auth. Leave both empty if you only use the Phase-2 admin UI
# and don't want the Phase-1 routes accessible at all. Set BOTH to switch it
# on: with either one empty the Phase-1 routes refuse every request.
ADMIN_USER=
ADMIN_PASSWORD=

# ────────────────────────────── Structured logging ────────────────────────
# Production containers emit JSON-per-line to stdout (ingestible by Loki,
# CloudWatch, ELK, etc.). Switch to LOG_FORMAT=console for human-readable
# colored output during local dev.
LOG_LEVEL=INFO
LOG_FORMAT=json

# ──────────────── Prometheus + Grafana observability stack ────────────────
# Audit-2026-05 #14 Phase 2. Both services come up with `docker compose up`
# and are reverse-proxied behind nginx with VIATOR's JWT-cookie auth.
# Operator access via https://<host>/grafana/ + /prometheus/.

# Prometheus TSDB retention. 30d ≈ 5-10 GB disk at default scrape interval;
# bump to 90 if you want quarter-over-quarter graphs, drop to 7 for tight VPS.
PROMETHEUS_RETENTION_DAYS=30

# ───────────────────────────── Docker socket GID ───────────────────────────
# The worker container runs as a non-root user (UID 1000) so it can't read
# /var/run/docker.sock by default. The host's docker group GID is
# distribution-dependent; supplying it here makes compose attach the worker
# user to that supplementary group.
#
# Find the host docker group GID:
#   getent group docker | cut -d: -f3
#
# Common defaults: 999 (Debian/Ubuntu apt-installed docker.io / docker-ce),
# 998 (some RHEL variants), 200 (Docker Desktop on macOS — different model,
# only matters if you build images locally on Mac and don't deploy from
# there). If unsure, run the getent command above on the deploy host.
DOCKER_GID=999
