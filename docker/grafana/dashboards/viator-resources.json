{
  "title": "VIATOR — Resources",
  "uid": "viator-resources",
  "tags": ["viator", "resources", "phase-2.5"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Host CPU usage",
      "description": "Aggregate across all cores. 100% = every core fully busy.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": { "graphMode": "area", "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host RAM in use",
      "description": "MemTotal − MemAvailable. Excludes page cache (Linux uses cache opportunistically; that's not 'used' for capacity purposes).",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "legendFormat": "RAM %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": { "graphMode": "area", "colorMode": "background" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Host swap in use",
      "description": "Swap should normally be 0 on a VPS sized for the workload. Non-zero = the host is dipping into disk and you'll feel it in latency.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes)",
          "legendFormat": "Swap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 1073741824 }
            ]
          }
        }
      },
      "options": { "graphMode": "area", "colorMode": "background" }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Host iowait",
      "description": "Share of CPU time spent waiting for the disk, averaged over all cores. Above 30 % for 10 minutes fires HostIowaitHigh (docker/prometheus/rules/resources.yml): usually swapping (see Swap by container) or a big OSM/feed read.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(irate(node_cpu_seconds_total{mode=\"iowait\"}[2m])) * 100",
          "legendFormat": "iowait"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "options": { "graphMode": "area", "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Host RAM — used vs available",
      "description": "RED = used (anything but page cache). GREEN = available (free + reclaimable cache). The big climb during an OTP build is the JVM heap.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 25, "stacking": { "mode": "normal" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host CPU usage by mode",
      "description": "user/system/iowait/etc. iowait spike = disk-bound (often happens during OSM PBF reads). Stuck at user≈100% = CPU-bound (OTP graph compute).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (irate(node_cpu_seconds_total{mode!=\"idle\"}[2m])) / on() group_left() count(node_cpu_seconds_total{mode=\"idle\"}) * 100",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 25, "stacking": { "mode": "normal" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container memory — by container",
      "description": "Working-set memory of every Docker container on the host (series with a non-empty `name` label, so MSMM and build containers such as `viator-build-<job>` show too). A build should plateau below its cgroup cap (`OTP_BUILD_MEM_LIMIT`, derived from the heap). Empty panel = cAdvisor lost the Docker names: the CadvisorNoContainerNames alert fires and admin guide §5.8 says what to check.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"], "sortBy": "Max", "sortDesc": true } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container CPU — by container",
      "description": "CPU usage per container, normalised to one core (so 200% = two cores fully busy). The OTP build container drives most of this during graph construction.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[2m])) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"], "sortBy": "Max", "sortDesc": true } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Swap by container",
      "description": "Swap each container holds (cAdvisor container_memory_swap). A capped container has no swap at all (memswap_limit = mem_limit), so a line above zero is an uncapped container: by default MOTIS, unless MOTIS_SERVE_MEM_LIMIT is set. Zero lines are kept on purpose: an empty panel then means cAdvisor lost the Docker names, not \"no swap\". `docker stats` does not show swap.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_swap{name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"], "sortBy": "Max", "sortDesc": true } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Capped containers — % of memory cap used",
      "description": "Working set as % of the container's memory cap, for containers that have one (OTP build and serve, MSMM, MOTIS when MOTIS_*_MEM_LIMIT is set; uncapped containers report a limit of 0 and are dropped by `> 0`; the comparison with the host RAM also drops any that report the host's size). There is no swap behind a cap: at 100 % the kernel OOM-kills the container (a serve container restarts and SessionContainerRestarted fires; a build fails with exit 137 in its log). Past 90 % during a build, give the session a bigger heap (the cap follows it) or raise OTP_BUILD_MEM_HEADROOM_GB; for a serve container raise OTP_SERVE_MEM_HEADROOM_GB.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{name!=\"\"} / on(name) ((container_spec_memory_limit_bytes{name!=\"\"} > 0) < on() group_left() max(node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"], "sortBy": "Max", "sortDesc": true } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Host disk — free space by mountpoint",
      "description": "Watch / and any /data mount during builds — graphs.tar can be tens of GB, and Postgres WAL grows during heavy session activity.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint!~\"/(boot|run|dev|sys|proc).*\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "min"] } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Web event-loop lag",
      "description": "How late web's event loop runs (issue #397): the largest delay of a 0.25 s timer over the last 60 s. Every async request and /healthz wait that long; the HEALTHCHECK fails past 10 s. Near zero when healthy; a rise means blocking work in an async handler. Alert WebEventLoopLagHigh: above 1 s for 5 min. A gap in the line is a scrape web did not answer.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "viator_web_event_loop_lag_seconds",
          "legendFormat": "web"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] } }
    }
  ]
}
